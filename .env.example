# Optional backend overrides. Leave DATABASE_URL unset for the repository-local
# database. On Render Free, use an explicitly temporary path; no persistent
# filesystem is available.
# DATABASE_URL=sqlite:////tmp/xplorers/spectra.db

# Optional absolute directory for retrieved FITS products. On Render Free this
# cache is temporary and may be lost after sleep, restart, or redeploy.
# SPHEREX_ARCHIVE_CACHE_DIR=/tmp/xplorers/archive_products

# Comma-separated explicit browser origins; local development origins remain
# allowed automatically. Do not use '*'.
# CORS_ALLOWED_ORIGINS=https://your-frontend.onrender.com

# Enable fail-closed safeguards for resource-heavy analysis on Render Free.
# XPLORERS_LOW_MEMORY_MODE=true

# Frontend API override belongs in frontend/.env.local (not in a public secret).
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# For a Render Static Site this is set in the build environment and embedded in
# the exported browser bundle. It is public and must not contain a credential.
# NEXT_PUBLIC_XPLORERS_EPHEMERAL_STORAGE=true
# NEXT_PUBLIC_XPLORERS_LOW_MEMORY_MODE=true
